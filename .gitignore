bin/
/snkv
/snkv.h
libsnkv.a
libsnkv_vec.a

# Test and example binaries: every extensionless file there is a build
# output (Linux/macOS), plus .exe on Windows.  Sources keep their extension.
tests/test_*
!tests/test_*.*
tests/*.exe
examples/*
!examples/*.*
examples/*.exe
examples/snkv.h

# Kept last so the "!" rules above cannot re-include them.
*.o
*.db
*.db-wal
*.db-shm
*.db-journal

# Fuzzing: build output, generated corpus, crash artifacts
fuzz/build/
fuzz/corpus/
fuzz/artifacts/
fuzz/fuzz_api
fuzz/fuzz_open
fuzz/gen_corpus
